# ==============================================================================
# STAGING ENVIRONMENT CONFIGURATION (.env.staging)
# ==============================================================================

# Database Configuration (Turso / LibSQL - Staging Database)
# IMPORTANTE: Usar la base de datos de staging (ej. comunidad-colegios-staging)
TURSO_DATABASE_URL="libsql://comunidad-colegios-staging-YOUR_ORG.turso.io"
TURSO_AUTH_TOKEN="your_staging_turso_auth_token_here"

# NextAuth Configuration (Staging URL)
# URL de despliegue de Vercel para la branch staging o subdominio asignado
NEXTAUTH_URL="https://staging.tu-dominio.com"
NEXTAUTH_SECRET="your_staging_nextauth_secret_minimum_32_characters"

# Google OAuth Credentials (Staging / Testing)
# Recuerda autorizar en Google Cloud Console:
# Origins: https://staging.tu-dominio.com
# Redirect URI: https://staging.tu-dominio.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Google Gemini API (Para moderación y corrección de avisos)
GEMINI_API_KEY="your_gemini_api_key"
GOOGLE_GENERATIVE_AI_API_KEY="your_gemini_api_key"
